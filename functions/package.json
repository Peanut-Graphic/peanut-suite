{
  "name": "peanut-suite-functions",
  "version": "1.0.0",
  "description": "Peanut Suite API - Shared backend for Notebook, Booker, and Festival",
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:audit-contract": "node --test test/verify-dependency-audit.test.mjs",
    "test:booking-auth": "npm run build && node --test test/booking-authorization.test.cjs",
    "test:emulator-parity": "node --test test/emulator-parity.cjs"
  },
  "engines": {
    "node": "22",
    "npm": "10.9.7"
  },
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "14.5.0",
    "firebase-functions": "^7.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.55.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "private": true
}
