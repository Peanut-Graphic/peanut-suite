{
    "name": "peanutgraphic/peanut-suite",
    "description": "Peanut Suite WordPress plugin - marketing toolkit (UTM, links, contacts, popups, analytics).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.4",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "composer/installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:property": "phpunit --testsuite=Property",
        "test:regression": "phpunit --testsuite=Regression"
    }
}
