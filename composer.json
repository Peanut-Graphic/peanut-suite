{
    "name": "peanutgraphic/peanut-suite",
    "description": "Peanut Suite - Complete Marketing Toolkit for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:property": "phpunit --testsuite=Property",
        "test:regression": "phpunit -c phpunit.regression.xml"
    }
}
